AA_ENVIRONMENT=dev
AA_DATABASE_URL=postgresql+asyncpg://admin:admin@postgres:5432/admin_agent
AA_REDIS_URL=redis://redis:6379/0
AA_MINIO_ENDPOINT=http://minio:9000
AA_MINIO_ACCESS_KEY=minioadmin
AA_MINIO_SECRET_KEY=minioadmin
AA_OLLAMA_BASE_URL=http://ollama:11434
AA_JWT_SECRET=change-me-in-production
AA_JWT_ALGORITHM=HS256
AA_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database pool and logging defaults
AA_DATABASE_POOL_SIZE=5
AA_DATABASE_MAX_OVERFLOW=10
AA_LOG_LEVEL=INFO

# Bootstrap owner created by `make bootstrap` (idempotent)
AA_BOOTSTRAP_EMAIL=owner@example.com
AA_BOOTSTRAP_PASSWORD=change-me

# Fernet key encrypting per-user connection credentials at rest (T3).
# Required when AA_ENVIRONMENT=production. Generate one with:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AA_CREDENTIALS_KEY=
