# Local-default development profile: chat and embeddings run on this machine via Ollama.
# This mirrors the product default (private local inference); nothing leaves the machine.
#
#   cp deployment/dev/ollama.env.example .env  # .env is git-ignored
#   ollama pull qwen2.5:7b-instruct && ollama pull nomic-embed-text
#   make demo && make dev                      # then, in another terminal: make chat

AA_ENVIRONMENT=dev
AA_LOG_LEVEL=INFO

# SQLite file for a quick start; Postgres instead (see docs/dev-setup.md):
# AA_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/admin_agent
AA_DATABASE_URL=sqlite+aiosqlite:///./dev.db
AA_STORAGE_BASE_DIR=./var/storage

# Development-only signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AA_JWT_SECRET=replace-with-a-random-dev-only-secret

# Chat model (local). A 7B instruct model needs roughly 5-6 GB of free RAM; on a
# smaller machine try a 3B variant (check `ollama list` / the Ollama library for tags).
AA_LLM_PROVIDER=ollama
AA_OLLAMA_BASE_URL=http://localhost:11434
AA_LLM_MODEL=qwen2.5:7b-instruct
AA_LLM_TIMEOUT_SECONDS=120
AA_AGENT_MAX_STEPS=6
AA_ALLOW_EXTERNAL_LLM=false

# Embeddings (local). The PostgreSQL vector column is 768-dimensional, so keep a
# 768-dimension model there; SQLite stores vectors as JSON and accepts any size.
AA_EMBEDDING_PROVIDER=ollama
AA_EMBEDDING_MODEL=nomic-embed-text
AA_EMBEDDING_DIM=768
