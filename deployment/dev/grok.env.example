# Light development profile: no VPS, weak machine, chat model hosted by xAI (Grok).
#
#   cp deployment/dev/grok.env.example .env    # .env is git-ignored; never commit a real key
#   make demo && make dev                      # then, in another terminal: make chat
#
# PRIVACY: with this profile every chat prompt, the conversation history, and the
# document passages the agent reads are sent to api.x.ai. Use it ONLY with the
# synthetic demo company (make demo). Never with real customer data and never in a
# client installation: there the default local Ollama inference is the product.

AA_ENVIRONMENT=dev
AA_LOG_LEVEL=INFO

# Zero-infrastructure database: one SQLite file in the repository root.
# Postgres instead (see docs/dev-setup.md):
# AA_DATABASE_URL=postgresql+asyncpg://admin:admin@localhost:5432/admin_agent
AA_DATABASE_URL=sqlite+aiosqlite:///./dev.db
AA_STORAGE_BASE_DIR=./var/storage

# Development-only signing secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AA_JWT_SECRET=replace-with-a-random-dev-only-secret

# Chat model: external OpenAI-compatible provider (xAI Grok).
# The app refuses to start unless AA_ALLOW_EXTERNAL_LLM=true and a key and base URL are set.
AA_LLM_PROVIDER=openai_compatible
AA_ALLOW_EXTERNAL_LLM=true
AA_LLM_BASE_URL=https://api.x.ai/v1
AA_LLM_API_KEY=<your-xai-api-key>
# Model ids change: check the exact name in the xAI console (console.x.ai) and pick
# one that supports function calling.
AA_LLM_MODEL=grok-4
AA_LLM_TIMEOUT_SECONDS=120
AA_AGENT_MAX_STEPS=6

# Embeddings never leave the machine. Pick one option:
#
# A) No model at all (weakest machine). The "fake" provider hashes words into
#    vectors: semantic/hybrid search still run, but they rank by shared words,
#    not by meaning (paraphrases and synonyms will not match).
AA_EMBEDDING_PROVIDER=fake
AA_EMBEDDING_DIM=768
#
# B) Local Ollama with only a small embedding model (no chat model needed):
#      ollama pull nomic-embed-text      # about 270 MB, 768 dimensions
# AA_EMBEDDING_PROVIDER=ollama
# AA_OLLAMA_BASE_URL=http://localhost:11434
# AA_EMBEDDING_MODEL=nomic-embed-text
# AA_EMBEDDING_DIM=768
#
# Switching embedding provider or model after seeding: delete dev.db and var/storage
# (or the Postgres volume) and run `make demo` again, so all vectors come from one model.
